GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional overrides
# GROQ_LLM_MODEL=qwen/qwen3.8-27b      # Ravi's model for English calls (Hindi/Tamil are set in languages.py)
# GROQ_EVAL_MODEL=openai/gpt-oss-120b           # QA scorer model
# GROQ_EVAL_FALLBACK_MODEL=openai/gpt-oss-20b   # used when the scorer model hits a rate limit (empty disables)
# GROQ_EVAL_REASONING_EFFORT=low                # low | medium | high

# Public demo only: usage caps (see README "Running a public demo")
# DEMO_MODE=1
# DEMO_VIDEO_URL=https://...
